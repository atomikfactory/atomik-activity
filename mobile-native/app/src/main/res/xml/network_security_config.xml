<?xml version="1.0" encoding="utf-8"?>
<!--
  This is a personal self-hosted app — HTTPS is not configured on the backend.
  Cleartext HTTP is permitted to ALL hosts so the user can point the app at any
  server IP via the in-app Server Settings without rebuilding the APK.
  External traffic (e.g., osmdroid map tiles) is HTTPS anyway.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
